#!/usr/bin/env bash
# bowser-ai-lite · Exige Conventional Commits: feat:, fix:, test:, docs:, refactor:, chore:, ci:, perf:, build:, style:, revert:
MSG=$(head -n1 "$1")
PATRON='^(feat|fix|test|docs|refactor|chore|ci|perf|build|style|revert)(\([a-z0-9._-]+\))?!?: .{3,}'
if [[ "$MSG" =~ ^(Merge|Revert\ \"|fixup!|squash!) ]] || [[ "$MSG" =~ $PATRON ]]; then
  exit 0
fi
echo "✗ Mensaje de commit inválido: \"$MSG\"" >&2
echo "  Usa Conventional Commits, por ejemplo: feat(usuarios): registro con correo" >&2
exit 1
